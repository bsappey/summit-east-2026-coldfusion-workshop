{
  "mcpServers": {
    "stylemart-fulfillment": {
      "url": "http://localhost:{{PORT}}{{CONTEXT}}/StyleMart/api/agent/s4/ref/mcp/fulfillment-server.cfm"
    },
    "weather-live": {
      "command": "{{JAVA_HOME}}/bin/{{JAVA_BIN}}",
      "args": ["-Dlogging.file.name={{WORKSHOP}}/externalservices/weather/live/logs/mcp-weather-live.log", "-jar", "{{WORKSHOP}}/externalservices/weather/live/target/mcp-weather-stdio-server.jar", "--spring.profiles.active=stdio"],
      "env": {"JAVA_HOME": "{{JAVA_HOME}}"},
      "commandWhitelist": ["{{JAVA_BIN}}", "{{JAVA_HOME}}/bin/{{JAVA_BIN}}"]
    },
    "prologics-logistics": {
      "url": "http://localhost:{{PORT}}{{CONTEXT}}/externalservices/prologics/mcp/prologics-mcp-server.cfm"
    }
  }
}
